<Window x:Class="TicketCassa0fConsertPlace.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TicketCassa0fConsertPlace"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                Title="Регистрация" Height="450" Width="800" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#eff6ff">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/70e61dbbd9f6adc94c501788cf59918d.jpg"/>
        </Grid.Background>
        <Border MinWidth="400" Margin="10,0,15,0" Background="#ffffff" VerticalAlignment="Center" Padding="30" MaxWidth="850" CornerRadius="20" Height="414">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#48036F" ShadowDepth="10"/>

            </Border.Effect>
            <StackPanel Margin="-7,-20,-20,-31">
                <TextBlock Text="Регистрация" Grid.Row="0" FontSize="30" FontWeight="Bold" Margin="0 0 0 20" Height="38"></TextBlock>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="cas" Content="Кассир" Margin="5,0"/>
                    <RadioButton x:Name="admin" Content="Администратор" Margin="5,0"/>
                </StackPanel>

                <TextBox  x:Name="fam" materialDesign:HintAssist.Hint="Введите фамилию" Grid.Row="2" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Height="48" ></TextBox>
                <TextBox  x:Name="name" materialDesign:HintAssist.Hint="Введите имя" Grid.Row="2" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Height="48" ></TextBox>
                <TextBox  x:Name="otch" materialDesign:HintAssist.Hint="Введите отчество" Grid.Row="2" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Height="48" ></TextBox>

                <TextBox  x:Name="loginnn" materialDesign:HintAssist.Hint="Введите логин" Grid.Row="2" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Height="48" ></TextBox>
                <PasswordBox x:Name="passworddd" materialDesign:HintAssist.Hint="Введите пароль"  Grid.Row="3" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" ></PasswordBox>
                <Button   Background="Black" Foreground="White" Click="Button_Click" HorizontalAlignment="Center" Grid.Row="5" Margin="0 20 0 0" Width="500" Content="Зарегистрироваться"/>
                <Button Click="vhod_Click" MouseEnter="vhod_MouseEnter" MouseLeave="vhod_MouseLeave" x:Name="vhod"  FontFamily="Leelawadee UI Semilight" Width="176" Content="Войти" Background="{x:Null}" Foreground="Black" BorderBrush="{x:Null}" BorderThickness="0,0,0,0"/>


            </StackPanel>
        </Border>
    </Grid>
</Window>